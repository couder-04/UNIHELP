# Isolated IIT Mandi demo databases (same Postgres cluster, different names).
# Copy to iit_mandi.env if you want to `source` it yourself.
# scripts/run_iit_mandi.sh exports these without copying secrets from .env.

ORG_PROFILE_PATH=orgs/iit_mandi.yaml
UNIHELP_PORT=8002
PUBLIC_BASE_URL=http://127.0.0.1:8002

AUTH_DB_NAME=mandi_campus_agent
MESS_DB_NAME=mandi_mess_menu
ROOM_DB_NAME=mandi_room_booking
BUS_DB_NAME=mandi_bus_schedule
COMPLAINTS_DB_NAME=mandi_complaints
ATTENDANCE_DB_NAME=mandi_organization_agent
NOTICE_DB_NAME=mandi_notice_board
TIMETABLE_DB_NAME=mandi_timetable

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,.venv/**,**/*.sql,timetable_users.csv}"
    }
  },
  "rewrites": [
    { "source": "/connect", "destination": "/gui/index.html" },
    { "source": "/ask", "destination": "/gui/ask.html" },
    { "source": "/activity", "destination": "/gui/activity.html" },
    { "source": "/commands", "destination": "/gui/commands.html" },
    { "source": "/users", "destination": "/gui/users.html" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}

# --- Copy this file to `.env` and fill in real values. Never commit `.env`. ---
# cp .env.example .env

# PostgreSQL connection (must match the server you load the *.sql files into)
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
# Local clusters: disable. Hosted Postgres (Neon, Vercel): require.
# If unset, localhost/127.0.0.1 default to disable and everything else to require.
PGSSLMODE=disable

# Database names (defaults match the `createdb` / `psql -f` steps below)
AUTH_DB_NAME=campus_agent
MESS_DB_NAME=mess_menu
ROOM_DB_NAME=room_booking
BUS_DB_NAME=bus_schedule
COMPLAINTS_DB_NAME=complaints
ATTENDANCE_DB_NAME=organization_agent
NOTICE_DB_NAME=notice_board
TIMETABLE_DB_NAME=timetable

# LLM API (get your own key; never commit it).
# Optional on Vercel: the campus console header can supply LLM_API_KEY per request.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://awesome.kado.so/openai/v1
LLM_MODEL=kado

# Public origin of this app (used in the A2A agent card).
# On Vercel production this should be the stable alias, not a unique dpl URL
# (those are often SSO-gated and personal agents cannot fetch them).
# PUBLIC_BASE_URL=https://unihelp-coral.vercel.app
